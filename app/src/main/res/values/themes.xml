<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.HandwritingRecognition" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Secondary accent color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_variant</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- No ActionBar theme for fullscreen experiences -->
    <style name="Theme.HandwritingRecognition.Fullscreen" parent="Theme.HandwritingRecognition">
        <item name="android:actionBarStyle">@style/Widget.HandwritingRecognition.ActionBar</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Widget.HandwritingRecognition.ActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/surface</item>
    </style>

    <!-- Button styles -->
    <style name="Theme.HandwritingRecognition.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="Theme.HandwritingRecognition.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/secondary</item>
        <item name="android:textColor">@color/secondary</item>
    </style>
</resources>
